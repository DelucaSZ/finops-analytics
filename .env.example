# PostgreSQL
POSTGRES_DB=nuvemiq
POSTGRES_USER=nuvemiq
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://nuvemiq:change-this-password@db:5432/nuvemiq

# Application
NUVEMIQ_ENVIRONMENT=development
NUVEMIQ_SECRET_KEY=replace-with-at-least-32-random-characters
# Used once to create the first database admin; later changes do not reset the user.
NUVEMIQ_ADMIN_EMAIL=admin@nuvemiq.local
NUVEMIQ_ADMIN_PASSWORD=replace-this-password
NUVEMIQ_ACCESS_TOKEN_MINUTES=480
NUVEMIQ_CORS_ORIGINS=http://localhost:3000,http://localhost
NUVEMIQ_WORKER_POLL_SECONDS=5
NUVEMIQ_DEMO_MODE=false

# AWS base credentials are supplied by the EC2 instance profile in production.
# For local development, use a normal AWS profile outside this repository.
AWS_DEFAULT_REGION=sa-east-1
AWS_ROLE_SESSION_NAME=nuvemiq-collector

# Optional AI explanations through Amazon Bedrock in the hosting account.
NUVEMIQ_AI_PROVIDER=disabled
NUVEMIQ_BEDROCK_REGION=us-east-1
NUVEMIQ_BEDROCK_MODEL_ID=

# Frontend
NEXT_PUBLIC_API_URL=/api/v1

# Authentication: absolute lifetime uses NUVEMIQ_ACCESS_TOKEN_MINUTES above.
NUVEMIQ_SESSION_IDLE_MINUTES=30
# Defaults to true in production, false in development (private HTTP only).
# NUVEMIQ_COOKIE_SECURE=true
# Set the public origin to produce absolute invitation/recovery links.
NUVEMIQ_PUBLIC_URL=

# Optional password recovery email; STARTTLS is mandatory unless SMTP_SSL=true.
NUVEMIQ_SMTP_HOST=
NUVEMIQ_SMTP_PORT=587
NUVEMIQ_SMTP_USERNAME=
NUVEMIQ_SMTP_PASSWORD=
NUVEMIQ_SMTP_FROM=
NUVEMIQ_SMTP_SSL=false

# MFA: set true to require TOTP enrollment for every account before external access.
NUVEMIQ_MFA_REQUIRED=false
# Optional dedicated Fernet key. If empty, derives a key from NUVEMIQ_SECRET_KEY.
# Keep this key (or the source secret) stable and backed up outside the database.
NUVEMIQ_MFA_ENCRYPTION_KEY=


# External production exposure (stage 6) - uncomment/adapt on the EC2 only.
# NUVEMIQ_ENVIRONMENT=production
# NUVEMIQ_PUBLIC_URL=https://deepops.example.com
# NUVEMIQ_CORS_ORIGINS=https://deepops.example.com
# NUVEMIQ_COOKIE_SECURE=true
# NUVEMIQ_MFA_REQUIRED=true
# NUVEMIQ_DEMO_MODE=false
