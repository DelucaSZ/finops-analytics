# PostgreSQL
POSTGRES_DB=nuvemiq
POSTGRES_USER=nuvemiq
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://nuvemiq:change-this-password@db:5432/nuvemiq

# Application
NUVEMIQ_ENVIRONMENT=development
NUVEMIQ_SECRET_KEY=replace-with-at-least-32-random-characters
NUVEMIQ_ADMIN_EMAIL=admin@nuvemiq.local
NUVEMIQ_ADMIN_PASSWORD=replace-this-password
NUVEMIQ_ACCESS_TOKEN_MINUTES=480
NUVEMIQ_CORS_ORIGINS=http://localhost:3000,http://localhost
NUVEMIQ_WORKER_POLL_SECONDS=5
NUVEMIQ_DEMO_MODE=false

# AWS base credentials are supplied by the EC2 instance profile in production.
# For local development, use a normal AWS profile outside this repository.
AWS_DEFAULT_REGION=sa-east-1
AWS_ROLE_SESSION_NAME=nuvemiq-collector

# Optional AI explanations through Amazon Bedrock in the hosting account.
NUVEMIQ_AI_PROVIDER=disabled
NUVEMIQ_BEDROCK_REGION=us-east-1
NUVEMIQ_BEDROCK_MODEL_ID=

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
